// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "soft_wrap": "editor_width",
  "base_keymap": "Zed",
  "telemetry": {
    "diagnostics": true,
    "metrics": false
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "One Dark",

  // ---------------------------------------------
  // Ported from ~/.vim (config.vim, autocmds.vim, commands.vim)
  // ---------------------------------------------
  "vim": {
    // set gdefault
    "gdefault": true,
  },
  // set ignorecase smartcase
  "use_smartcase_search": true,
  // set tabstop=2 shiftwidth=2 expandtab
  "tab_size": 2,
  "languages": {
    // autocmd FileType python set tabstop=4 shiftwidth=4
    "Python": {
      "tab_size": 4,
    },
  },
  // set colorcolumn=80
  "wrap_guides": [80],
  // set list listchars=tab:»·,trail:· -- Zed can only show every tab by also
  // showing all indentation, so this shows trailing whitespace only
  "show_whitespaces": "trailing",
  "whitespace_map": {
    "space": "·",
    "tab": "»",
  },
  // set nofoldenable -- hide the fold arrows
  "gutter": {
    "folds": false,
  },
  // autocmd FocusLost * :wa
  "autosave": "on_window_change",
  // command! W w / command! Q q
  "command_aliases": {
    "W": "w",
    "Q": "q",
  },
  // :ListLeaders, but automatic: pops up the available bindings after a
  // prefix like space or g
  "which_key": {
    "enabled": true,
    "delay_ms": 600,
  },
  // Language plugins from vim-plug.vim that Zed doesn't ship with
  "auto_install_extensions": {
    "csv": true,
    "less": true,
    "nginx": true,
    "scala": true,
    "swift": true,
    "terraform": true,
    "tmux": true,
    "xml": true,
  },

  // Dock the terminal on the right so it opens beside the editor like a
  // vsplit. Opening the panel reuses its terminal and only starts one if
  // none exists.
  "terminal": {
    "dock": "right",
  },
}
