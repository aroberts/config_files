__check(){
  which "$1" >/dev/null
}
__uname(){
  uname -a | grep "$1" >/dev/null
}
__uname_not(){
  uname -a | grep -v "$1" >/dev/null
}


alias versions_pip="pip freeze | grep -v \"^\-e\" | cut -d = -f 1 | xargs -n 1 pip search | grep -B2 'LATEST:'"
alias outline='ag --nocolor "^\s*(class|def)\s"'
alias sl=ls

alias ag='\ag --pager="less -XFR"'

alias xjcp='xargs -J % cp %'

__uname Darwin && alias fixscreen='sudo launchctl unload -w /System/Library/LaunchDaemons/com.apple.screensharing.plist &&  sudo launchctl load -w /System/Library/LaunchDaemons/com.apple.screensharing.plist'
__uname Darwin && __check caffeinate && alias keep_screen_awake="caffeinate -dims || true"

alias tls='tmux ls'

# Install Ghostty's terminfo on a remote host so TERM=xterm-ghostty works there.
# Usage: install-ghostty-ssh-terminfo user@host
install-ghostty-ssh-terminfo() {
  if [ $# -ne 1 ]; then
    echo "usage: install-ghostty-ssh-terminfo <user@host>" >&2
    return 1
  fi
  infocmp -x xterm-ghostty | ssh "$1" -- tic -x -
}

which htop >/dev/null && alias top=htop

__check dscacheutil && alias flush_dns="dscacheutil -flushcache && sudo killall -HUP mDNSResponder"

__check docker && docker-running-versions() {
  docker inspect $(docker ps  | awk '{print $2}' | grep -v ID) | jq -c .[].RepoTags
}

__check terraform && alias tf=terraform

__check ansible-vault && alias av=ansible-vault
__check ansible-playbook && alias ap="time ansible-playbook"

__check docker && alias docker-ip="docker inspect --format '{{ .NetworkSettings.IPAddress }} {{ .Name }}'"

__check docker && dcon() {
  if [ $# -eq 0 ]; then
    docker context ls
  elif [ $# -eq 1 ]; then
    docker context use "$1"
  else
    docker context "$@"
  fi
}

__check claude && tmp-claude() {
  cd `mktemp -d -t claude-tmp` && claude
}

__check claude && alias clop='claude --model opus --effort xhigh'

# Over ssh the login keychain is locked, and claude can't read its credentials.
# Unlock it first, prompting only when it's actually locked.
__uname Darwin && __check claude && rclaude() {
  security show-keychain-info >/dev/null 2>&1 || security unlock-keychain || return 1
  claude "$@"
}

__uname_not Darwin && alias ls='ls --color'
__uname_not Darwin && function addsysuser() {
  syntax="addsysuser <description> <shortname>"
  if [[ -z "$1" || -z "$2" ]]; then
    echo $syntax
  else
    $__SUDOCMD adduser -D -g "$1" "$2" "$2" && id "$2"
  fi
}

unfunction __check
unfunction __uname
unfunction __uname_not
